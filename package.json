{
  "name": "baby-english",
  "version": "1.0.0",
  "description": "让3岁幼儿无痛玩学，12个月系统掌握500句高频生活化英文短句",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace BabyEnglish.xcworkspace -scheme BabyEnglish -configuration Release -destination generic/platform=iOS build",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/BabyEnglish/main.jsbundle"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-screens": "^3.26.0",
    "react-native-safe-area-context": "^4.7.2",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.5.4",
    "react-native-vector-icons": "^10.0.0",
    "react-native-svg": "13.9.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-native": "^0.72.5",
    "@types/jest": "^29.5.8",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.2.2",
    "detox": "^20.10.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.0",
    "@testing-library/jest-native": "^5.4.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "moduleNameMapper": {
      "^react-native-sqlite-storage$": "<rootDir>/tests/__mocks__/emptyModule.js",
      "^react-native-sound$": "<rootDir>/tests/__mocks__/emptyModule.js",
      "^@react-native-voice/voice$": "<rootDir>/tests/__mocks__/emptyModule.js",
      "^lottie-react-native$": "<rootDir>/tests/__mocks__/emptyModule.js",
      "^@react-native-community/netinfo$": "<rootDir>/tests/__mocks__/emptyModule.js"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/build/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "Baby English Team",
  "license": "MIT",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "type": "commonjs"
}
